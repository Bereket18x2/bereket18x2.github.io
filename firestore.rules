rules_version = '2';

// ===========================================================
// Firestore rules for finote-yared.
//
// The client config in assets/js/config.js is public by design.
// THIS FILE is the security boundary — not the API key. Assume an
// attacker has the config, is signed in with a real account, and is
// calling Firestore directly from a console. Everything below is
// written against that assumption.
//
// ROLES
//   student          a child's account, opened by their parent
//   pending_teacher  registered, not yet approved — reads NOTHING but
//                    their own document
//   rejected         a refused request, kept as history
//   teacher          reads and manages ONLY their assigned students
//   admin            everything, plus approving teachers and assigning
//                    students. Roles are only ever changed by an admin.
//
// Deploy:  firebase deploy --only firestore:rules
// Tested:  tools/rules.test.mjs against the Firestore emulator
// ===========================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Read off the token, not off the user doc: the doc's `verified`
    // field is a cached copy the client can be behind on, while the
    // token is issued by Firebase itself and cannot be forged.
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function myDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? myDoc().role : '';
    }

    // Each of these costs one document read every time it is evaluated.
    // Rules short-circuit, so they are always placed LAST in a condition:
    // a student's own write must never pay for a lookup that will return
    // false anyway. At 120 study-time writes an hour, putting them first
    // would burn the free read quota for nothing.
    function isAdmin() {
      return myRole() == 'admin';
    }

    /* A teacher may act on a student only if that student's document
       names them. assignedTeacher is written by an admin alone, so a
       teacher cannot widen their own reach.

       Two forms, and the difference matters. Inside /users/{uid},
       `resource` IS the student document, so the check reads it directly
       — which is one fewer document read AND the only form that works
       for a list query, where get() is not evaluated per result. In the
       progress subcollection `resource` is the progress document, so
       there the parent has to be fetched. */
    function isMyStudentDoc() {
      return resource != null
        && resource.data.assignedTeacher == request.auth.uid
        && myRole() == 'teacher';
    }

    function isMyStudentByGet(uid) {
      return myRole() == 'teacher'
        && get(/databases/$(database)/documents/users/$(uid)).data.assignedTeacher == request.auth.uid;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /* Fields no account may ever write about itself.

       role                 self-promotion to teacher or admin
       assignedTeacher      a teacher choosing which children they can read
       paid/amountPaid/
       paidUntil            granting yourself a paid term
       tier/track/
       selectedSubjects     deciding which curriculum you bought
       unlockedLessons      opening lessons a teacher has not opened
       remedial*            a teacher's judgement about a child
       badges               computed at render; a stored one could be forged
       email/uid/createdAt  identity and history
       consent*             a compliance record; one a parent can rewrite
                            is not a record

       This is the single list every self-write is checked against, so a
       new privileged field is protected by being added here rather than
       by remembering to guard it at each call site. */
    function lockedFields() {
      return [
        'role', 'assignedTeacher',
        'paid', 'amountPaid', 'paidUntil',
        'tier', 'track', 'selectedSubjects',
        'unlockedLessons', 'remedial', 'remedialSince', 'remedialBy',
        'badges',
        'email', 'uid', 'createdAt',
        'consentGivenAt', 'consentVersion',
        'approvedBy', 'approvedAt', 'rejectedReason'
      ];
    }

    match /users/{uid} {

      // A student reads only their own row. A teacher reads their own
      // assigned students. An admin reads everyone. Without the scoping,
      // one compromised teacher account is the whole roster of children.
      allow read: if isOwner(uid) || isMyStudentDoc() || isAdmin();

      /* Registration. Two shapes are allowed and no others.

         A student account pins the fields that decide privilege and
         money, and carries the parental consent record. A teacher
         request may only ever be created as 'pending_teacher' — never
         'teacher', never 'admin' — so approval is something an admin
         does, not something a registrant claims.

         consentGivenAt == request.time is what serverTimestamp()
         resolves to, so a client cannot backdate when consent was given. */
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.consentVersion is string
        && request.resource.data.consentVersion.size() > 0
        && request.resource.data.consentGivenAt == request.time
        && (
          (
            request.resource.data.role == 'student'
            && request.resource.data.paid == false
            && request.resource.data.studySeconds == 0
            && !('assignedTeacher' in request.resource.data)
            && !('amountPaid' in request.resource.data)
            && !('paidUntil' in request.resource.data)
          ) || (
            request.resource.data.role == 'pending_teacher'
            && !('assignedTeacher' in request.resource.data)
            && !('paid' in request.resource.data)
          )
        );

      /* Three ways a document is updated, cheapest first.

         1. The owner maintaining their own profile — no reads, and
            forbidden from every field in lockedFields().
         2. Their assigned teacher confirming payment, unlocking a
            lesson, or recording remedial support. A teacher may NOT
            write role or assignedTeacher: a teacher who could do either
            could promote a student to admin, or hand themselves another
            teacher's class.
         3. An admin, who may write anything — including approving a
            teacher and assigning students.

         studySeconds may only ever rise, and by one batch at a time.
         lesson.html flushes every 30s; the +120 ceiling leaves slack for
         a delayed flush while making it useless for minting attendance. */
      allow update: if (
        isOwner(uid)
        && !changed().hasAny(lockedFields())
        && (
          !changed().hasAny(['verified'])
          || request.resource.data.verified == request.auth.token.email_verified
        )
        && (
          !changed().hasAny(['studySeconds'])
          || (
            request.resource.data.studySeconds >= resource.data.studySeconds
            && request.resource.data.studySeconds <= resource.data.studySeconds + 120
          )
        )
      ) || (
        isMyStudentDoc()
        && !changed().hasAny(['role', 'assignedTeacher', 'uid', 'email', 'createdAt',
                              'consentGivenAt', 'consentVersion'])
      ) || isAdmin();

      // These are records of children. A misfired script in a browser
      // must not be able to erase a student's history; removal is a
      // deliberate act performed from the console.
      allow delete: if false;

      match /progress/{lessonId} {

        allow read: if isOwner(uid) || isAdmin() || isMyStudentByGet(uid);

        // create/update rather than write, because `write` would also
        // grant delete — and a student who can delete a result can erase
        // a bad score and retake the quiz clean. Marks are append-only;
        // store.js already keeps the better of the two.
        //
        // Requiring verified() keeps throwaway signups out of the
        // teachers' roster: no quiz result exists for an account that
        // never proved it owns its email address.
        //
        // A lesson is written TWICE with different shapes — first
        // videoCompleted/coverage when the video ends, then score/of when
        // the quiz is submitted — so each field is validated only if
        // present rather than demanding the full set on every write.
        allow create, update: if isOwner(uid)
          && verified()
          && (
            !('score' in request.resource.data)
            || (
              request.resource.data.score is int
              && request.resource.data.of is int
              && request.resource.data.score >= 0
              && request.resource.data.score <= request.resource.data.of
            )
          )
          && (
            !('coverage' in request.resource.data)
            || (
              request.resource.data.coverage is number
              && request.resource.data.coverage >= 0
              && request.resource.data.coverage <= 1
            )
          )
          // sessionSeconds and suspicious are client-written and a
          // determined client can lie about both. These bounds only keep
          // the types sane so the roster cannot be broken by junk.
          && (
            !('sessionSeconds' in request.resource.data)
            || (request.resource.data.sessionSeconds is int
                && request.resource.data.sessionSeconds >= 0)
          )
          && (
            !('suspicious' in request.resource.data)
            || request.resource.data.suspicious is bool
          );

        allow delete: if false;
      }
    }

    // A parent asking for their child's record to be erased. This raises
    // a flag for a teacher; it deletes nothing. Deletion stays a
    // deliberate human act, because /users/{uid} refuses client deletes.
    //
    // The document id is the uid, so a parent can raise exactly one
    // request and a teacher can find the account directly.
    match /deletionRequests/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time;

      // Only a teacher marks one done. An owner who could update it could
      // mark their own request handled, quietly removing it from the queue
      // it was meant to enter.
      allow update, delete: if isAdmin();
    }

    // Curriculum is readable by any signed-in student but authored only
    // by teachers — otherwise a student could rewrite the quiz answers
    // they are about to be marked against.
    match /lessons/{lessonId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Anything not named above does not exist as far as clients are
    // concerned. New collections must be granted access deliberately,
    // rather than inheriting it by accident.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
